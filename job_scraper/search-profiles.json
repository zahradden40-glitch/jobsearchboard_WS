{
  "version": 1,

  "_comment": [
    "Economics / VWL / Economic Research job search, Germany-wide and cross-border commuter regions.",
    "",
    "PORTALS: defaults hold arbeitsagentur-search (German federal official API backbone),",
    "stepstone-search, and freehire-search. xing-search and linkedin-search are opted into",
    "the core title profiles to keep request volume low.",
    "",
    "TARGETS: Junior, PreDoc, Research Assistant, Wissenschaftlicher Mitarbeiter,",
    "Werkstudent, Praktikum, and Graduate / Entry-level roles.",
    "",
    "LOCATION is nationwide (DE) by default. Overrides scope freehire to DE and LinkedIn to Germany."
  ],

  "defaults": {
    "jobage": 3,
    "limit": 25,
    "portals": ["arbeitsagentur-search", "stepstone-search", "freehire-search"],
    "portal_overrides": {
      "freehire-search": { "country": "DE" },
      "linkedin-search": { "location": "Germany" }
    }
  },

  "profiles": [
    { "id": "volkswirt",                        "enabled": true,  "query": "Volkswirt",
      "portals": ["+xing-search", "+linkedin-search"] },
    { "id": "volkswirtschaftslehre",            "enabled": true,  "query": "Volkswirtschaftslehre",
      "portals": ["+xing-search", "+linkedin-search"] },
    { "id": "economist-en",                     "enabled": true,  "query": "Economist",
      "portals": ["+xing-search", "+linkedin-search"] },
    { "id": "economic-research-en",             "enabled": true,  "query": "Economic Research",
      "portals": ["+xing-search", "+linkedin-search"] },
    { "id": "wirtschaftsforschung",             "enabled": true,  "query": "Wirtschaftsforschung",
      "portals": ["+xing-search"] },
    { "id": "wirtschaftsanalyse",               "enabled": true,  "query": "Wirtschaftsanalyse",
      "portals": ["+xing-search"] },
    { "id": "entwicklungsokonomie",             "enabled": true,  "query": "Entwicklungsökonomie" },
    { "id": "development-economics-en",         "enabled": true,  "query": "Development Economics" },
    { "id": "wirtschaftspolitik",               "enabled": true,  "query": "Wirtschaftspolitik" },
    { "id": "policy-analysis-en",               "enabled": true,  "query": "Policy Analysis" },
    { "id": "umweltoekonomie",                  "enabled": true,  "query": "Umweltökonomie" },
    { "id": "energieoekonomie",                 "enabled": true,  "query": "Energieökonomie" },
    { "id": "arbeitsmarktoekonomie",            "enabled": true,  "query": "Arbeitsmarktökonomie" },
    { "id": "aussenwirtschaft",                 "enabled": true,  "query": "Außenwirtschaft" },
    { "id": "finanzwissenschaft",               "enabled": true,  "query": "Finanzwissenschaft" },
    { "id": "werkstudent-vwl",                  "enabled": true,  "query": "Werkstudent VWL" },
    { "id": "praktikum-vwl",                    "enabled": true,  "query": "Praktikum VWL" },
    { "id": "wiss-mitarbeiter-vwl",             "enabled": true,  "query": "Wissenschaftlicher Mitarbeiter VWL" },
    { "id": "research-assistant-econ",          "enabled": true,  "query": "Research Assistant Economics" },
    { "id": "predoc-economics",                 "enabled": true,  "query": "PreDoc Economics" },

    { "id": "applied-economics-en",             "enabled": false, "query": "Applied Economics",
      "_note": "English variant; enable for broader international scope." },
    { "id": "gesundheitsoekonomie",             "enabled": false, "query": "Gesundheitsökonomie",
      "_note": "Specialized health economics net. Enable for healthcare research institutes." }
  ]
}
